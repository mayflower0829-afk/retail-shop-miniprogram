<view class="page"><view class="title">{{editing?'商品资料与图片':'新增商品'}}</view><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{authorized}}"><view class="card space-top"><image wx:if="{{image}}" class="product-photo" src="{{image}}" mode="aspectFit"/><button class="secondary" bindtap="photo" disabled="{{busy}}">{{image?'更换商品图片':'选择商品图片'}}</button><view class="note space-top">从微信聊天中选择图片，可先将照片发到文件传输助手。没有图片会保存为草稿。</view><view class="label">商品名称 *</view><input class="field" value="{{name}}" data-field="name" bindinput="field" maxlength="120" disabled="{{busy}}" placeholder="填写商品名称"/><block wx:if="{{!editing}}"><view class="label">原零售价（元）*</view><input class="field" type="digit" value="{{price}}" data-field="price" bindinput="field" disabled="{{busy}}" placeholder="例如20.00"/><view class="label">可售库存（件）*</view><input class="field" type="number" value="{{stock}}" data-field="stock" bindinput="field" disabled="{{busy}}" placeholder="例如10"/><view class="label">款式（选填）</view><input class="field" value="{{skuName}}" data-field="skuName" bindinput="field" maxlength="60" disabled="{{busy}}" placeholder="默认款"/></block><view class="row"><view class="grow"><view class="label">分组</view><picker range="{{groups}}" value="{{groupIndex}}" bindchange="group" disabled="{{busy}}"><view class="field">{{groups[groupIndex]}} ⌄</view></picker></view><view class="grow"><view class="label">类型</view><picker range="{{types}}" value="{{typeIndex}}" bindchange="type" disabled="{{busy}}"><view class="field">{{types[typeIndex]}} ⌄</view></picker></view></view><view class="label">IP / 作品（选填）</view><input class="field" value="{{ip}}" data-field="ip" bindinput="field" maxlength="60" disabled="{{busy}}"/><view class="label">商品介绍（选填）</view><textarea class="field" value="{{description}}" data-field="description" bindinput="field" maxlength="1000" disabled="{{busy}}"/><view wx:if="{{!editing}}" class="row"><text>保存后上架</text><switch checked="{{active}}" bindchange="active" disabled="{{busy}}" color="#c65370"/></view><view wx:if="{{editing}}" class="note">价格、补货和上下架请在商品管理中修改。</view></view><button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">{{editing?'保存资料':'保存商品'}}</button></block></view>
