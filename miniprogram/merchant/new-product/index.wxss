.new-product-page{padding-bottom:64rpx}.editor-content{margin-top:22rpx}.draft-notice{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:64rpx;margin:0 4rpx 14rpx;color:#827d85;font-size:23rpx}.new-product-page .draft-clear{width:auto;min-width:0;max-width:100%;min-height:56rpx;padding:4rpx 12rpx;line-height:2;background:transparent;color:#a94763;font-size:23rpx;white-space:nowrap;font-weight:500}.editor-section{padding:24rpx;margin-bottom:22rpx}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}.section-name{font-size:29rpx;font-weight:650}.section-meta{font-size:22rpx;color:#827d85;white-space:nowrap}.section-note{color:#827d85;font-size:23rpx;line-height:1.7;margin-top:16rpx}.required{color:#b64c65;margin-left:4rpx}.form-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18rpx}.form-grid>view{min-width:0}.new-product-page .label{font-size:24rpx;margin-top:18rpx}.new-product-page .field{width:100%;min-width:0;margin-bottom:0;background:#fafafa}.select-field{display:flex;align-items:center;justify-content:space-between;gap:8rpx}.select-field>text:first-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.select-arrow{color:#b49aa8}.sale-preview{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8rpx 16rpx;margin-top:18rpx;padding:16rpx 18rpx;background:#f7f3f5;border-radius:16rpx;color:#a05b72;font-size:22rpx}.sale-value{font-size:31rpx;font-weight:700;margin-left:8rpx;white-space:nowrap}.publish-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #f3ebee;font-size:26rpx}.description-field{min-height:170rpx;height:170rpx}.save-area{margin-top:26rpx}.save-area button{width:100%}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx 14rpx}.photo-card,.photo-add-tile{width:100%;min-width:0;max-width:100%;animation:photo-arrive .14s ease-out backwards}.photo-media{position:relative;height:0;padding-top:100%;overflow:hidden;border:1rpx solid #f0e7e8;border-radius:17rpx;background:#fafafa}.photo-media image{position:absolute;inset:0;width:100%;height:100%;display:block}.cover-badge{position:absolute;top:8rpx;left:8rpx;padding:3rpx 9rpx;border-radius:8rpx;background:#b64c65;color:#fff;font-size:20rpx;line-height:1.5}.new-product-page .photo-remove{min-width:0;max-width:100%;position:absolute;top:4rpx;right:4rpx;width:52rpx;height:52rpx;min-height:52rpx;padding:0;line-height:50rpx;border-radius:50%;background:rgba(255,255,255,.92);color:#745969;font-size:34rpx;font-weight:400}.cover-current,.cover-button,.photo-add-caption{display:flex;align-items:center;justify-content:center;min-height:58rpx;font-size:22rpx;line-height:1.5;padding:8rpx 0;white-space:nowrap}.cover-current{color:#a05b72}.new-product-page .cover-button{width:100%;min-width:0;max-width:100%;background:transparent;color:#a94763;font-weight:500;border-radius:12rpx}.photo-add-caption{color:#a8919e;font-size:20rpx}.new-product-page .photo-add{position:relative;width:100%;min-width:0;max-width:100%;height:0;min-height:0;padding:100% 0 0;border:2rpx dashed #e8c6d1;border-radius:17rpx;background:#faf9fa;color:#af607a;font-size:23rpx;font-weight:500;line-height:1.5}.photo-add-content{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx}.photo-add-symbol{font-size:46rpx;font-weight:300;line-height:1}.photo-empty{min-width:0;grid-column:span 2;align-self:center;display:flex;flex-direction:column;gap:12rpx;padding:0 8rpx 46rpx;font-size:26rpx;line-height:1.6}.photo-empty .muted{font-size:22rpx}.photo-action-hover{opacity:.65}.photo-add-hover{background:#f9e6ed;transform:scale(.98)}
@keyframes photo-arrive{from{opacity:0}to{opacity:1}}
@media (prefers-reduced-motion:reduce){.photo-card,.photo-add-tile{animation:none}.photo-remove,.cover-button,.photo-add,.draft-clear{transition:none}.photo-add-hover{transform:none}}
