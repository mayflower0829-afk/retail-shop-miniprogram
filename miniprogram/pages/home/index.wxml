<import src="../../templates/loading.wxml"/>
<view class="page home-page page-motion"><view class="row brand-header"><view class="row brand"><image class="brand-avatar" src="/assets/shop-avatar.png"/><view><view class="title">{{shopName}}</view><view class="subtitle">把喜欢，收进日常</view></view></view><text class="brand-badge">谷子专门店</text></view>
 <view class="campaign-strip"><text class="campaign-title">{{promotionTitle}}</text><text>{{shippingText}}</text></view>
 <view class="quick-links"><view data-group="明谷" bindtap="category" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="quick-icon pink">明</view><text>明谷现货</text></view><view data-group="盲盒" bindtap="category" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="quick-icon yellow">盒</view><text>盲盒专区</text></view><view data-type="吧唧" bindtap="category" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="quick-icon purple">唧</view><text>吧唧徽章</text></view><view data-type="挂件" bindtap="category" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="quick-icon mint">挂</view><text>随身挂件</text></view></view>
 <view wx:if="{{demo}}" class="demo">试用版 · 商品已导入，演示付款不扣款</view><view class="search-box"><input class="search" placeholder="作品、角色、款式，可空格组合搜索" value="{{keyword}}" bindinput="search" bindconfirm="confirmSearch" confirm-type="search" maxlength="80"/><button wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch" aria-label="清空搜索">×</button></view>
 <view class="row"><view class="tabs compact-tabs"><text wx:for="{{filters}}" wx:key="*this" class="tab {{filter===item?'active':''}}" data-value="{{item}}" bindtap="filter">{{item}}</text></view><view class="stock-toggle"><switch checked="{{onlyStock}}" bindchange="stock" color="#ec7489"/><text>有货</text></view></view>
 <view class="row result-bar"><text class="muted">{{resultCount || 0}} 件好物{{loading && visible.length ? " · 更新中" : ""}}</text><text wx:if="{{filtersActive}}" class="link small" bindtap="resetFilters">重置筛选</text><picker range="{{sortOptions}}" value="{{sortIndex || 0}}" bindchange="sort"><text class="muted">{{sortOptions[sortIndex || 0]}} ⌄</text></picker></view><template wx:if="{{loading && !visible.length}}" is="product-grid-loading"/>
 <view wx:if="{{visible.length}}" class="grid content-motion"><view class="product" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="detail" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="product-media"><image src="{{item.image}}" mode="aspectFit" lazy-load data-id="{{item.id}}" catchtap="preview" aria-role="button" aria-label="预览{{item.displayName}}图片"/><text wx:if="{{item.stock===0}}" class="sold-out">暂时售罄</text></view><view class="product-body"><text wx:if="{{item.ip!=='待分类'}}" class="product-ip">{{item.ip}}</text><view class="product-name">{{item.displayName}}</view><view class="row product-meta"><view><text class="price">¥{{item.priceText}}</text><text wx:if="{{item.hasDiscount}}" class="original-price">¥{{item.originalPriceText}}</text></view></view><view class="row product-purchase"><text class="stock-label">{{item.stock>0?'库存 '+item.stock:'售罄'}}</text><button class="quick-add" data-id="{{item.id}}" catchtap="quickAdd" disabled="{{item.stock===0}}" aria-label="{{item.skus.length>1?'选择款式':'加入购物车'}}" hover-start-time="30" hover-stay-time="80">{{item.skus.length>1?'选款':'+ 加购'}}</button></view></view></view></view>
 <button wx:if="{{hasMore}}" class="secondary more-button" bindtap="more" hover-start-time="30" hover-stay-time="80">查看更多商品</button><view wx:if="{{!visible.length && !loading}}" class="empty"><view class="empty-icon">♡</view><view>{{error || '没有找到商品，换个关键词试试吧'}}</view><button wx:if="{{error}}" class="secondary" bindtap="reload" hover-start-time="30" hover-stay-time="80">重新加载</button><button wx:elif="{{filtersActive}}" class="secondary" bindtap="resetFilters">查看全部商品</button></view><view class="footer-text">每一份喜欢，都值得认真对待</view>
</view>
