<view class="page home-page"><view class="row brand-header"><view class="row brand"><image class="brand-avatar" src="/assets/shop-avatar.png"/><view><view class="title">{{shopName}}</view><view class="subtitle">把喜欢，收进日常</view></view></view><text class="brand-badge">零售小店</text></view>
 <view class="campaign-strip"><text class="campaign-title">{{promotionTitle}}</text><text>折后满69元包邮 · 支持自取</text></view>
 <view wx:if="{{!keyword}}" class="quick-links"><view data-group="明谷" bindtap="category"><view class="quick-icon pink">明</view><text>明谷现货</text></view><view data-group="盲盒" bindtap="category"><view class="quick-icon yellow">盒</view><text>盲盒专区</text></view><view data-type="吧唧" bindtap="category"><view class="quick-icon purple">唧</view><text>吧唧徽章</text></view><view data-type="挂件" bindtap="category"><view class="quick-icon mint">挂</view><text>随身挂件</text></view></view>
 <view wx:if="{{demo}}" class="demo">试用版 · 商品已导入，演示付款不扣款</view><input class="search" placeholder="搜索作品、角色、商品名称" value="{{keyword}}" bindinput="search"/>
 <view class="row"><view class="tabs compact-tabs"><text wx:for="{{filters}}" wx:key="*this" class="tab {{filter===item?'active':''}}" data-value="{{item}}" bindtap="filter">{{item}}</text></view><view class="stock-toggle"><switch checked="{{onlyStock}}" bindchange="stock" color="#ec7489"/><text>有货</text></view></view>
 <view class="row result-bar"><text class="muted">{{resultCount || 0}} 件好物</text><picker range="{{sortOptions}}" value="{{sortIndex || 0}}" bindchange="sort"><text class="muted">{{sortOptions[sortIndex || 0]}} ⌄</text></picker></view><view wx:if="{{loading}}" class="empty">正在寻找好物…</view>
 <view class="grid"><view class="product" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><view class="product-media"><image src="{{item.image}}" mode="aspectFit" lazy-load data-id="{{item.id}}" catchtap="preview" aria-role="button" aria-label="预览{{item.displayName}}图片"/><text wx:if="{{item.stock===0}}" class="sold-out">暂时售罄</text></view><view class="product-body"><text wx:if="{{item.ip!=='待分类'}}" class="product-ip">{{item.ip}}</text><view class="product-name">{{item.displayName}}</view><view class="row product-meta"><view><text class="price">¥{{item.priceText}}</text><text wx:if="{{item.hasDiscount}}" class="original-price">¥{{item.originalPriceText}}</text></view></view><view class="row product-purchase"><text class="stock-label">{{item.stock>0?'库存 '+item.stock:'售罄'}}</text><button class="quick-add" data-id="{{item.id}}" catchtap="quickAdd" disabled="{{item.stock===0}}" aria-label="{{item.skus.length>1?'选择款式':'加入购物车'}}">{{item.skus.length>1?'选款':'+ 加购'}}</button></view></view></view></view>
 <button wx:if="{{hasMore}}" class="secondary more-button" bindtap="more">查看更多商品</button><view wx:if="{{!visible.length && !loading}}" class="empty"><view class="empty-icon">♡</view><view>{{error || '没有找到商品，换个关键词试试吧'}}</view><button wx:if="{{error}}" class="secondary" bindtap="reload">重新加载</button></view><view class="footer-text">每一份喜欢，都值得认真对待</view>
</view>
