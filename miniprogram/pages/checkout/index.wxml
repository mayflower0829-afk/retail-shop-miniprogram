<view class="page"><view class="title">确认心动清单</view><view class="subtitle">全场五折 · 折后满69元包邮</view><view wx:if="{{demo}}" class="demo">本地试用订单，演示付款不扣款。</view>
 <view class="card"><view class="section">收货方式</view><view class="delivery-options"><view class="delivery-option {{deliveryMode==='delivery'?'active':''}}" data-mode="delivery" bindtap="mode"><view>快递配送</view><view class="muted">寄到你的收货地址</view></view><view wx:if="{{pickupEnabled}}" class="delivery-option {{deliveryMode==='pickup'?'active':''}}" data-mode="pickup" bindtap="mode"><view>到店自取</view><view class="muted">免运费 · 凭码领取</view></view></view></view>
 <view wx:if="{{deliveryMode==='delivery'}}" class="card" bindtap="address"><view wx:if="{{address}}"><view>{{address.name}}　{{address.phone}}</view><view class="note">{{address.region[0]}}{{address.region[1]}}{{address.region[2]}}{{address.detail}}</view><view class="link space-top">更换地址 ›</view></view><view wx:else class="link">＋ 添加收货地址</view></view>
 <view wx:else class="card"><view class="section">自取信息</view><view class="note">地点：{{pickupLocation || '待店铺补充'}}</view><view class="note">时间：{{pickupHours || '待店铺补充'}}</view><input class="field" value="{{pickupName}}" placeholder="取货联系人姓名" maxlength="30" data-field="pickupName" bindinput="field"/><input class="field" value="{{pickupPhone}}" placeholder="11位手机号码" type="number" maxlength="11" data-field="pickupPhone" bindinput="field"/><view class="note">付款后等待店铺备货。显示“待自取”后，凭自取码领取。</view><view wx:if="{{demo && (!pickupLocation || !pickupHours)}}" class="demo">自取地点和时间尚待补充，目前可模拟体验；正式自取交易需配置后开放。</view></view>
 <view class="error" wx:if="{{error || shippingError}}">{{error || shippingError}}</view><view class="card"><view class="row line" wx:for="{{lines}}" wx:key="skuId"><image class="thumb" src="{{item.image}}" mode="aspectFit"/><view class="grow"><view>{{item.displayName || item.name}}</view><view class="muted">{{item.skuName==='表中原款'?'':item.skuName}} × {{item.qty}}</view><view><text class="price">¥{{item.priceText}}</text><text class="original-price">¥{{item.originalPriceText}}</text></view></view></view></view>
 <view class="card"><view class="row line"><text>原价合计</text><text>¥{{originalSubtotal}}</text></view><view class="row line"><text>五折活动优惠</text><text class="link">−¥{{discount}}</text></view><view class="row line"><text>折后商品金额</text><text>¥{{subtotal}}</text></view><view class="row line"><text>{{deliveryMode==='pickup'?'自取运费':'运费'}}</text><text>{{shipping==='待确认'?'待确认':'¥'+shipping}}</text></view><view class="row line"><text>应付金额</text><text class="price">{{total==='—'?'待确认':'¥'+total}}</text></view></view>
 <view class="note">请在提交订单后15分钟内完成付款。</view><view class="bottom row"><text class="price">{{total==='—'?'邮费待确认':'¥'+total}}</text><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || !!error || !!shippingError}}">{{demo?'提交试用订单':'提交订单'}}</button></view>
</view>
