<import src="../../templates/consent.wxml"/>
<view class="page page-motion"><view class="title">确认订单</view><view class="subtitle">{{shippingText}}</view><view wx:if="{{demo}}" class="demo">本地试用订单，演示付款不扣款。</view>
 <view class="card"><view class="section">收货方式</view><view class="delivery-options"><view class="delivery-option {{deliveryMode==='delivery'?'active':''}}" data-mode="delivery" bindtap="mode" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view>快递配送</view><view class="muted">寄到你的收货地址</view></view><view wx:if="{{pickupEnabled}}" class="delivery-option {{deliveryMode==='pickup'?'active':''}}" data-mode="pickup" bindtap="mode" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view>到店自取</view><view class="muted">免运费 · 凭码领取</view></view></view></view>
 <block wx:if="{{!privacyAccepted}}"><template is="fulfillmentConsent" data="{{consentChecked,consentBusy,consentError,demo}}"/></block>
 <block wx:else>
 <view wx:if="{{deliveryMode==='delivery'}}" class="card fulfillment-panel" bindtap="address" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view wx:if="{{address}}"><view>{{address.name}}　{{address.phone}}</view><view class="note">{{address.region[0]}}{{address.region[1]}}{{address.region[2]}}{{address.detail}}</view><view class="link space-top">更换地址 ›</view></view><view wx:else class="link">＋ 添加收货地址</view></view>
 <view wx:else class="card fulfillment-panel"><view class="section">自取信息</view><view class="note">地点：{{pickupLocation || '待店铺补充'}}</view><view class="note">时间：{{pickupHours || '待店铺补充'}}</view><input class="field" value="{{pickupName}}" placeholder="取货联系人姓名" maxlength="30" data-field="pickupName" bindinput="field"/><input class="field" value="{{pickupPhone}}" placeholder="11位手机号码" type="number" maxlength="11" data-field="pickupPhone" bindinput="field"/><view class="note">付款后等待店铺备货。显示“待自取”后，凭自取码领取。</view><view wx:if="{{demo && (!pickupLocation || !pickupHours)}}" class="demo">自取地点和时间尚待补充，目前可模拟体验；正式自取交易需配置后开放。</view></view>
 </block>
 <view wx:if="{{loading}}" class="note">正在核对库存和价格…</view><view wx:if="{{notice}}" class="demo">{{notice}}</view>
 <view wx:if="{{!loading && !error && !shippingError}}" class="note">{{shippingHint}}</view>
 <view class="card" wx:if="{{error || shippingError}}"><view class="error">{{error || shippingError}}</view><view class="note">所选商品已保留，可重新核对或返回调整。</view><view class="row"><button class="secondary" bindtap="reload" disabled="{{busy || loading}}">重新核对</button><button class="secondary" bindtap="browse" disabled="{{busy}}">返回选购</button></view></view><view wx:if="{{lines.length}}" class="card"><view class="row line" wx:for="{{lines}}" wx:key="skuId"><image class="thumb" src="{{item.image}}" mode="aspectFit"/><view class="grow"><view>{{item.displayName || item.name}}</view><view class="muted">{{item.skuName==='表中原款'?'':item.skuName}} × {{item.qty}}</view><view><text class="price">¥{{item.priceText}}</text><text wx:if="{{hasDiscount}}" class="original-price">¥{{item.originalPriceText}}</text></view></view></view></view>
 <view wx:if="{{hasQuote}}" class="card quote-summary {{loading?'is-refreshing':''}}"><view class="row line"><text>原价合计</text><text>¥{{originalSubtotal}}</text></view><view wx:if="{{hasDiscount}}" class="row line"><text>{{promotionTitle}}优惠</text><text class="link">−¥{{discount}}</text></view><view class="row line"><text>商品实付合计</text><text>¥{{subtotal}}</text></view><view class="row line"><text>{{deliveryMode==='pickup'?'自取运费':'运费'}}</text><text>{{shipping==='待确认'?'待确认':'¥'+shipping}}</text></view><view class="row line"><text>应付金额</text><text class="price">{{total==='—'?'待确认':'¥'+total}}</text></view></view>
 <view class="note">请在提交订单后15分钟内完成付款。</view><view class="bottom row"><text class="price">{{loading?'核对中':total==='—'?'金额待确认':'¥'+total}}</text><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || (!orderCreated && (loading || !quoteReady || !privacyAccepted || !!error || !!shippingError))}}" hover-start-time="30" hover-stay-time="80">{{orderCreated?'查看订单':loading?'核对中':demo?'提交试用订单':'提交订单'}}</button></view>
</view>
