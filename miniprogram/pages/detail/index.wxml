<import src="../../templates/loading.wxml"/>
<view class="page detail-page page-motion">
  <view wx:if="{{error}}" class="empty">{{error}}</view>
  <template wx:if="{{loading && !p}}" is="detail-loading"/>
  <block wx:if="{{p}}">
    <view class="detail-media"><swiper class="detail-gallery" duration="240" current="{{galleryIndex}}" bindchange="galleryChange">
      <swiper-item wx:for="{{gallery}}" wx:key="*this"><image class="detail-image" src="{{item}}" mode="aspectFit" data-index="{{index}}" bindtap="preview" aria-role="button" aria-label="查看商品大图" binderror="imageFailed"/></swiper-item>
    </swiper><view class="gallery-caption"><text>{{hasImage?'轻点查看大图':'商品图片待补充'}}</text><text wx:if="{{gallery.length>1}}" class="gallery-count">{{galleryIndex+1}} / {{gallery.length}}</text></view></view>
    <view wx:if="{{imageError}}" class="note image-retry" bindtap="retryImage" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">{{imageError}}</view>
    <view class="card detail-summary content-motion">
      <view class="row"><view><text class="price detail-price">¥{{price}}</text><text wx:if="{{p.hasDiscount}}" class="original-price">¥{{originalPrice}}</text></view><button class="favorite-toggle {{favorite?'is-favorite':''}}" bindtap="favorite" aria-label="{{favorite?'取消收藏':'收藏商品'}}" hover-start-time="30" hover-stay-time="80">{{favorite?'♥ 已收藏':'♡ 收藏'}}</button></view>
      <view class="section detail-name">{{p.displayName}}</view>
      <text wx:if="{{p.hasDiscount}}" class="promotion-tag">{{p.promotionTitle}}</text><text class="tag">{{p.group}}</text>
      <view wx:if="{{description}}" class="note space-top">{{description}}</view>
    </view>
    <view class="card purchase-options">
      <view class="section">{{p.skus.length>1?'选择款式':'购买数量'}}</view>
      <view wx:if="{{p.skus.length>1}}" class="chips sku-options"><view wx:for="{{p.skus}}" wx:key="id" data-id="{{item.id}}" class="chip {{sku.id===item.id?'active':''}} {{item.stock===0?'sku-unavailable':''}}" bindtap="select" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">{{item.name}}{{item.stock===0?' · 售罄':''}}</view></view>
      <view class="row"><text class="muted">库存 {{sku.stock}}</text><view class="qty"><button data-delta="-1" bindtap="qty" disabled="{{qty<=1 || !sku.stock}}" aria-label="减少购买数量" hover-start-time="30" hover-stay-time="80">−</button><text>{{qty}}</text><button data-delta="1" bindtap="qty" disabled="{{qty>=sku.stock || qty>=99}}" aria-label="增加购买数量" hover-start-time="30" hover-stay-time="80">＋</button></view></view>
      <view class="delivery-note">{{shippingText}}</view>
    </view>
    <view class="bottom row detail-toolbar"><button class="service-button" bindtap="help" aria-label="联系客服" hover-start-time="30" hover-stay-time="80">客服</button><button class="secondary" bindtap="add" disabled="{{!sku.stock}}" hover-start-time="30" hover-stay-time="80">加入购物车</button><button class="primary" bindtap="buy" disabled="{{!sku.stock}}" hover-start-time="30" hover-stay-time="80">立即购买</button></view>
  </block>
</view>
