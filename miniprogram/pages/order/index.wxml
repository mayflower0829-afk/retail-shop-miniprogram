<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="reload">重试</button></view><block wx:if="{{o}}"><view class="hero"><view class="status">{{status}}</view><view class="tag">{{o.deliveryMode==='pickup'?'到店自取':'快递配送'}}</view><view class="subtitle">{{o.demo?'演示订单 · 不扣款':''}}</view><view wx:if="{{step>=0 && o.deliveryMode!=='pickup'}}" class="progress-track"><view class="progress-step {{step>=0?'done':''}}"><view class="progress-dot"/>待付款</view><view class="progress-step {{step>=1?'done':''}}"><view class="progress-dot"/>待发货</view><view class="progress-step {{step>=2?'done':''}}"><view class="progress-dot"/>待收货</view><view class="progress-step {{step>=3?'done':''}}"><view class="progress-dot"/>已完成</view></view></view><view class="card"><view wx:for="{{o.lines}}" wx:key="skuId" class="line">{{item.displayName || item.name}}<view class="muted">{{item.skuName==='表中原款'?'':item.skuName}} × {{item.qty}}</view></view><view wx:if="{{o.discountAmount}}" class="row line"><text>五折活动优惠</text><text class="link">−¥{{discount}}</text></view><view class="row line"><text>订单合计（含运费）</text><text class="price">¥{{total}}</text></view></view><view wx:if="{{o.deliveryMode!=='pickup'}}" class="card"><view>{{o.address.name}}　{{o.address.phone}}</view><view class="note">{{o.address.region[0]}}{{o.address.region[1]}}{{o.address.region[2]}}{{o.address.detail}}</view><view class="muted line order-id" selectable="true">订单号：{{o.id}}</view><view class="order-time">下单时间：{{date}}</view></view><view wx:if="{{o.deliveryMode==='pickup'}}" class="card"><view class="section">自取信息</view><view>{{o.pickupContact.name}}　{{o.pickupContact.phone}}</view><view class="note">地点：{{o.pickupLocation || '待店铺补充'}}</view><view class="note">时间：{{o.pickupHours || '待店铺补充'}}</view><view wx:if="{{o.status==='ready_pickup'}}" class="pickup-code"><view class="muted">自取码 · 到店出示给店铺核销</view><text selectable="true">{{o.pickupCode}}</text></view><view wx:if="{{o.status==='paid'}}" class="note">正在等待店铺备货，请显示待自取后领取。</view><view class="muted line order-id">订单号：{{o.id}}</view><view class="order-time">下单时间：{{date}}</view></view><view wx:if="{{o.tracking}}" class="card"><view>物流：{{o.carrier}}</view><view class="line">{{o.tracking}}</view><button class="secondary" bindtap="copy">复制快递单号</button></view><view wx:if="{{o.status==='refund_requested'}}" class="card">售后原因：{{o.refundReason}}<view class="note">处理进度请联系店主。</view></view><view class="chips"><button wx:if="{{o.status==='pending'}}" class="primary" bindtap="pay" loading="{{busy}}" disabled="{{busy}}">{{o.demo?'演示付款':'微信支付'}}</button><button wx:if="{{o.status==='pending'}}" data-action="cancel" bindtap="operate" disabled="{{busy}}">取消订单</button><button wx:if="{{o.status==='shipped'}}" class="primary" data-action="receive" bindtap="operate" disabled="{{busy}}">确认收货</button><button class="secondary" bindtap="contact">联系店主</button><button bindtap="sync">刷新状态</button></view></block></view>
