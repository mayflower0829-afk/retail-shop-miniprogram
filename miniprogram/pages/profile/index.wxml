<view class="page page-motion"><view class="profile-header row"><image class="profile-avatar" src="/assets/shop-avatar.png" bindlongpress="adminAccess"/><view class="grow"><view class="title">{{shopName}}</view><view class="subtitle">订单与账户</view></view></view><view wx:if="{{demo}}" class="demo">本地试用版 · 演示付款不扣款</view>
 <view wx:if="{{orderError}}" class="error" bindtap="retryOrders" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">{{orderError}}</view>
 <view class="card"><view class="row"><view class="section">我的订单</view><text class="muted" data-status="all" bindtap="orders">全部订单 ›</text></view><view class="order-shortcuts"><view data-status="pending" bindtap="orders" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="shortcut-symbol">¥<text wx:if="{{counts.pending}}" class="count-badge">{{counts.pending}}</text></view><text>待付款</text></view><view data-status="paid" bindtap="orders" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="shortcut-symbol">□<text wx:if="{{counts.paid}}" class="count-badge">{{counts.paid}}</text></view><text>待发货</text></view><view data-status="shipped" bindtap="orders" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="shortcut-symbol">→<text wx:if="{{counts.shipped}}" class="count-badge">{{counts.shipped}}</text></view><text>待收货</text></view><view data-status="ready_pickup" bindtap="orders" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="shortcut-symbol">⌖<text wx:if="{{counts.ready_pickup}}" class="count-badge">{{counts.ready_pickup}}</text></view><text>待自取</text></view><view data-status="completed" bindtap="orders" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="shortcut-symbol">✓<text wx:if="{{counts.completed}}" class="count-badge">{{counts.completed}}</text></view><text>已完成</text></view></view></view>
 <view class="card"><view class="list-row row" bindtap="favorites" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="row"><text class="menu-symbol">♡</text><text>我的收藏</text></view><text class="muted">{{favoriteCount}} 件 ›</text></view><view class="list-row row" data-page="address" bindtap="go" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="row"><text class="menu-symbol">⌖</text><text>收货地址</text></view><text class="muted">›</text></view><view class="list-row row" data-page="help" bindtap="go" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="row"><text class="menu-symbol">☏</text><text>联系店主</text></view><text class="muted">›</text></view><view wx:if="{{isAdmin}}" class="list-row row" data-page="admin" bindtap="go" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="row"><text class="menu-symbol">▦</text><text>{{demo?'演示店铺管理':'店铺管理'}}</text></view><text class="muted">›</text></view><view class="list-row row" data-page="terms" bindtap="go" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><text>用户服务协议</text><text class="muted">›</text></view><view class="list-row row" data-page="privacy" bindtap="go" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><text>隐私政策与授权设置</text><text class="muted">›</text></view></view>
</view>
