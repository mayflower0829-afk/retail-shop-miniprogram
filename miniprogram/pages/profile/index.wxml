<view class="page"><view class="profile-header row"><image class="profile-avatar" src="/assets/shop-avatar.png"/><view class="grow"><view class="title">欢迎来到{{shopName}}</view><view class="subtitle">给每一份热爱，一个小小的家</view></view></view><view wx:if="{{demo}}" class="demo">本地试用版 · 演示付款不扣款</view>
 <view class="card"><view class="row"><view class="section">我的订单</view><text class="muted" data-status="all" bindtap="orders">全部订单 ›</text></view><view class="order-shortcuts"><view data-status="pending" bindtap="orders"><view class="shortcut-symbol">¥<text wx:if="{{counts.pending}}" class="count-badge">{{counts.pending}}</text></view><text>待付款</text></view><view data-status="paid" bindtap="orders"><view class="shortcut-symbol">□<text wx:if="{{counts.paid}}" class="count-badge">{{counts.paid}}</text></view><text>待发货</text></view><view data-status="shipped" bindtap="orders"><view class="shortcut-symbol">→<text wx:if="{{counts.shipped}}" class="count-badge">{{counts.shipped}}</text></view><text>待收货</text></view><view data-status="ready_pickup" bindtap="orders"><view class="shortcut-symbol">⌖<text wx:if="{{counts.ready_pickup}}" class="count-badge">{{counts.ready_pickup}}</text></view><text>待自取</text></view><view data-status="completed" bindtap="orders"><view class="shortcut-symbol">✓<text wx:if="{{counts.completed}}" class="count-badge">{{counts.completed}}</text></view><text>已完成</text></view></view></view>
 <view class="card"><view class="list-row row" bindtap="favorites"><view class="row"><text class="menu-symbol">♡</text><text>我的收藏</text></view><text class="muted">{{favoriteCount}} 件 ›</text></view><view class="list-row row" data-page="address" bindtap="go"><view class="row"><text class="menu-symbol">⌖</text><text>收货地址</text></view><text class="muted">›</text></view><view class="list-row row" data-page="help" bindtap="go"><view class="row"><text class="menu-symbol">☏</text><text>联系店主</text></view><text class="muted">›</text></view><view wx:if="{{isAdmin}}" class="list-row row" data-page="admin" bindtap="go"><view class="row"><text class="menu-symbol">▦</text><text>{{demo?'演示店铺管理':'店铺管理'}}</text></view><text class="muted">›</text></view></view><view class="footer-text">示例零售店 · 每一份喜欢都值得认真对待</view>
</view>
