<import src="../../templates/loading.wxml"/>
<view class="page cart-page page-motion"><view class="title">购物车</view><view class="subtitle">{{shippingText}}</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="reload" hover-start-time="30" hover-stay-time="80">重新加载</button></view><template wx:if="{{loading && !lines.length}}" is="cart-loading"/><view wx:if="{{!lines.length && !loading}}" class="empty"><view class="empty-icon">♡</view><view>购物车还是空的</view><view class="muted">选购喜欢的商品</view><button class="secondary space-top" bindtap="browse" hover-start-time="30" hover-stay-time="80">去选款</button></view>
 <view wx:if="{{unavailableCount}}" class="row cart-cleanup"><text class="muted">{{unavailableCount}}款已下架或售罄</text><button class="secondary small" bindtap="cleanUnavailable" disabled="{{loading || !!error}}">清理失效商品</button></view>
 <view class="card cart-line {{item.invalid?'cart-line-invalid':''}}" wx:for="{{lines}}" wx:key="skuId"><view class="row"><view class="selection-hit" data-id="{{item.skuId}}" bindtap="toggle" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="选择{{item.name}}"><view class="selection-mark {{item.selected?'is-checked':''}}"><text>✓</text></view></view><product-image class="thumb" src="{{item.image}}"/><view class="grow"><view class="two-lines">{{item.name}}</view><view class="muted space-top">{{item.skuName==='表中原款'?'':item.skuName}}</view><view class="space-top"><text class="price">¥{{item.price}}</text><text wx:if="{{item.hasDiscount}}" class="original-price">¥{{item.originalPrice}}</text></view></view></view><view wx:if="{{item.invalid}}" class="error">{{item.invalidReason}}</view><view class="row cart-controls"><text class="muted" data-id="{{item.skuId}}" bindtap="remove">移除</text><view class="qty"><button data-id="{{item.skuId}}" data-delta="-1" bindtap="qty" disabled="{{item.qty<=1 || item.unavailable}}" hover-start-time="30" hover-stay-time="80">−</button><text>{{item.qty}}</text><button data-id="{{item.skuId}}" data-delta="1" bindtap="qty" disabled="{{item.qty>=item.stock || item.qty>=99}}" hover-start-time="30" hover-stay-time="80">＋</button></view></view></view>
 <view wx:if="{{lines.length}}" class="bottom cart-bottom"><view class="cart-status {{invalidSelectedCount?'is-warning':''}}">{{invalidSelectedCount?'请调整或取消勾选无法购买的商品':shippingHint}}</view><view class="shipping-progress-track"><view style="transform:scaleX({{shippingProgress / 100}})"/></view><view class="row"><view class="row select-all" bindtap="toggleAll" aria-role="checkbox" aria-checked="{{allSelected}}" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="selection-mark {{allSelected?'is-checked':''}}"><text>✓</text></view><text>全选</text></view><view class="cart-total"><text class="muted">商品合计</text><view class="price">¥{{total}}</view></view><button class="primary" bindtap="checkout" disabled="{{!count || loading || !!error || invalidSelectedCount>0}}" hover-start-time="30" hover-stay-time="80">结算（{{count}}）</button></view><view class="note">折后商品合计，运费在结算页单独显示</view></view>
</view>
