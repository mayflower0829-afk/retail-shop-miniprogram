<import src="../../templates/loading.wxml"/>
<view class="page cart-page page-motion"><view class="title">心动购物袋</view><view class="subtitle">{{shippingText}}</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="reload" hover-start-time="30" hover-stay-time="80">重新加载</button></view><template wx:if="{{loading && !lines.length}}" is="cart-loading"/><view wx:if="{{!lines.length && !loading}}" class="empty"><view class="empty-icon">♡</view><view>购物袋还是空的</view><view class="muted">去发现喜欢的周边吧</view><button class="secondary space-top" bindtap="browse" hover-start-time="30" hover-stay-time="80">去选款</button></view>
 <view class="card cart-line" wx:for="{{lines}}" wx:key="skuId"><view class="row"><text class="check" data-id="{{item.skuId}}" bindtap="toggle">{{item.selected?'●':'○'}}</text><image class="thumb" src="{{item.image || '/assets/placeholder.jpg'}}" mode="aspectFit"/><view class="grow"><view class="two-lines">{{item.name}}</view><view class="muted space-top">{{item.skuName==='表中原款'?'':item.skuName}}</view><view class="space-top"><text class="price">¥{{item.price}}</text><text wx:if="{{item.hasDiscount}}" class="original-price">¥{{item.originalPrice}}</text></view></view></view><view wx:if="{{item.invalid}}" class="error">库存不足或已下架，请调整数量或移除</view><view class="row cart-controls"><text class="muted" data-id="{{item.skuId}}" bindtap="remove">移除</text><view class="qty"><button data-id="{{item.skuId}}" data-delta="-1" bindtap="qty" disabled="{{item.qty<=1}}" hover-start-time="30" hover-stay-time="80">−</button><text>{{item.qty}}</text><button data-id="{{item.skuId}}" data-delta="1" bindtap="qty" disabled="{{item.qty>=item.stock || item.qty>=99}}" hover-start-time="30" hover-stay-time="80">＋</button></view></view></view>
 <view wx:if="{{lines.length}}" class="bottom cart-bottom"><view class="shipping-progress-text">{{shippingHint}}</view><view class="shipping-progress-track"><view style="transform:scaleX({{shippingProgress / 100}})"/></view><view class="row"><view class="row select-all" bindtap="toggleAll" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><text class="check">{{allSelected?'●':'○'}}</text><text>全选</text></view><view class="cart-total"><text class="muted">商品合计</text><view class="price">¥{{total}}</view></view><button class="primary" bindtap="checkout" disabled="{{!count}}" hover-start-time="30" hover-stay-time="80">结算（{{count}}）</button></view><view class="note">折后商品合计，运费在结算页单独显示</view></view>
</view>
