/* 共用样式位于 app.wxss */

.cart-line{padding:24rpx}.cart-line-invalid{border-color:#ebd4d8}.cart-line .thumb{width:128rpx;height:128rpx}.cart-line .price{font-size:32rpx}.cart-controls{padding-top:18rpx;margin-top:20rpx}.cart-controls>.muted{padding:8rpx 0}.selection-hit{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:44px;min-height:44px}.selection-mark{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:36rpx;height:36rpx;border:2rpx solid #d7beca;border-radius:50%;color:#fff;background:#fff;transition:background-color .14s ease-out,border-color .14s ease-out}.selection-mark>text{font-size:24rpx;line-height:1;opacity:0;transform:scale(.75);transition:opacity .14s ease-out,transform .14s ease-out}.selection-mark.is-checked{background:#b64c65;border-color:#b64c65}.is-checked>text{opacity:1;transform:scale(1)}.select-all{gap:12rpx;min-height:80rpx}.cart-status{height:36rpx;line-height:36rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;text-align:center;font-size:23rpx;font-weight:600;color:#a54863;margin-bottom:14rpx}.cart-status.is-warning{color:#ae405c}.cart-bottom .price{font-size:38rpx}.cart-bottom .primary{border-radius:18rpx}.cart-bottom .note{margin-top:12rpx}.cart-page{padding-bottom:330rpx}
@media (prefers-reduced-motion:reduce){.selection-mark,.selection-mark>text{transition:none}.selection-mark>text{transform:none}}

.cart-line .two-lines,.cart-line .muted{word-break:break-all}.cart-cleanup{flex-wrap:wrap}
