<import src="../../templates/consent.wxml"/>
<view class="page">
 <view class="title">{{editing?'收货信息':selecting?'选择收货地址':'我的地址簿'}}</view><view class="subtitle">{{selecting?'点击地址，用于本次订单':'常用地址，随时切换'}}</view>
 <block wx:if="{{!privacyAccepted}}"><template is="fulfillmentConsent" data="{{consentChecked,consentBusy,consentError,demo}}"/></block>
 <block wx:else>
 <block wx:if="{{!editing}}">
  <view wx:for="{{addresses}}" wx:key="id" class="card address-card" data-id="{{item.id}}" bindtap="choose">
   <view class="row"><view class="address-name">{{item.name}} <text class="muted">{{item.phone}}</text></view><text class="tag" wx:if="{{item.isDefault}}">默认</text></view>
   <view class="note address-detail">{{item.region[0]}}{{item.region[1]}}{{item.region[2]}} {{item.detail}}</view>
   <view class="row address-tools"><text class="link" wx:if="{{!item.isDefault}}" data-id="{{item.id}}" catchtap="makeDefault">设为默认</text><text class="muted" wx:else>默认收货地址</text><view class="row"><text class="link" data-id="{{item.id}}" catchtap="edit">编辑</text><text class="muted" data-id="{{item.id}}" catchtap="remove">删除</text></view></view>
  </view>
  <view wx:if="{{!addresses.length}}" class="empty">还没有收货地址</view><button class="primary" bindtap="add">＋ 新增收货地址</button>
 </block>
 <block wx:else>
  <view class="card"><view class="label">收货人</view><input class="field" value="{{name}}" placeholder="请输入姓名" maxlength="30" data-field="name" bindinput="field"/><view class="label">手机号</view><input class="field" value="{{phone}}" type="number" placeholder="11位手机号码" maxlength="11" data-field="phone" bindinput="field"/><view class="label">所在地区</view><picker mode="region" value="{{region}}" bindchange="region"><view class="field region-field">{{region.length?region[0]+' / '+region[1]+' / '+region[2]:'请选择省 / 市 / 区'}}<text>⌄</text></view></picker><view class="label">详细地址</view><textarea class="field" value="{{detail}}" placeholder="街道、楼栋、门牌号" maxlength="200" data-field="detail" bindinput="field"/><view class="row"><text>设为默认地址</text><switch checked="{{isDefault}}" color="#ec7489" bindchange="markDefault"/></view></view>
  <button class="primary" bindtap="save">保存{{selecting?'并使用':''}}地址</button><button class="secondary space-top" bindtap="cancel">返回地址列表</button>
 </block><view class="footer-text">地址保存在当前设备，最多20条。</view>
 </block>
</view>
