<view class="page admin-page page-motion">
  <view class="title">店铺管理</view>
  <view wx:if="{{authorized}}" class="card row space-top menu-card" bindtap="products" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view><view class="section">商品与库存</view><view class="muted">新增商品、Excel导入、改价与上下架</view></view><text class="link">管理 ›</text></view>
  <view wx:if="{{authorized}}" class="card row menu-card" bindtap="settings" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view><view class="section">活动折扣</view><view class="muted">自由填写全店折扣，也可恢复原价</view></view><text class="link">设置 ›</text></view>
  <view wx:if="{{authorized && overview}}" class="card"><view class="row"><view class="section">今日营业</view><text class="muted">{{overview.date}}</text></view><view class="row"><view><view class="muted">今日已付金额（含运费）</view><view class="price">¥{{overview.paidText}}</view></view><view><view class="muted">已付订单</view><view class="amount">{{overview.paidCount}}</view></view></view><view class="chips"><view class="chip" data-status="paid" data-mode="delivery" bindtap="summaryFilter" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">待发货 {{overview.deliveryToShip}}</view><view class="chip" data-status="paid" data-mode="pickup" bindtap="summaryFilter" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">待备货 {{overview.pickupToPrepare}}</view><view class="chip" data-status="ready_pickup" data-mode="pickup" bindtap="summaryFilter" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">待自取 {{overview.pickupReady}}</view><view class="chip" data-status="refund_requested" bindtap="summaryFilter" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">售后待处理 {{overview.refundRequests}}</view></view><view wx:if="{{overview.refundedCents}}" class="note">今日已记录退款 ¥{{overview.refundedText}}</view><view wx:if="{{overview.unknownRefunds}}" class="note">{{overview.unknownRefunds}}笔退款金额待核对</view><view wx:if="{{overview.shippingUnsynced}}" class="error">{{overview.shippingUnsynced}}笔已交付订单尚未同步微信</view></view><view wx:if="{{authorized && overviewError}}" class="note">营业统计暂时无法加载，订单仍可管理</view><view wx:if="{{authorized}}" class="card row menu-card" bindtap="exportData" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view><view class="section">导出与备份</view><view class="muted">商品库存、订单表格与数据备份</view></view><text class="link">打开 ›</text></view>
  <view wx:if="{{authorized && !demo}}" class="card"><view class="section">微信收款</view><view class="note">{{paymentStatus}}</view></view><view class="section">店铺订单</view><view wx:if="{{authorized}}"><view class="row"><input class="search grow" value="{{searchText}}" bindinput="searchInput" bindconfirm="search" disabled="{{busy}}" maxlength="60" placeholder="订单号或联系电话"/><button class="secondary" bindtap="search" disabled="{{busy}}" hover-start-time="30" hover-stay-time="80">搜索</button></view><view class="chips"><view wx:for="{{deliveryOptions}}" wx:key="id" class="chip {{deliveryMode===item.id?'active':''}}" data-id="{{item.id}}" bindtap="deliveryFilter" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">{{item.name}}</view></view></view><scroll-view wx:if="{{authorized}}" scroll-x class="filter-scroll"><view class="tabs"><text wx:for="{{tabs}}" wx:key="id" class="tab {{status===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</text></view></scroll-view><view wx:if="{{demo}}" class="demo">此设备的演示订单</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{checking || (loading && !orders.length)}}" class="empty">正在加载店铺订单…</view>
  <button wx:if="{{error}}" class="secondary" bindtap="reload" disabled="{{busy}}">重新加载订单</button>
  <view wx:if="{{authorized && !checking && !loading && !orders.length && !error}}" class="empty">没有符合条件的订单</view>
  <view wx:for="{{orders}}" wx:key="id" class="card admin-order">
    <view class="row"><text class="tag">{{item.kind==='payment_test'?'支付测试 · 不发货':item.deliveryMode==='pickup'?'到店自取':'快递配送'}}</text><text class="order-status">{{item.statusName}}</text></view>
    <view class="admin-order-item row" wx:for="{{item.preview}}" wx:for-item="line" wx:key="skuId"><product-image class="thumb" src="{{line.image || '/assets/placeholder.jpg'}}" mode="aspectFit" lazy-load/><view class="grow two-lines">{{line.displayName}}</view><text class="muted">×{{line.qty}}</text></view>
    <view wx:if="{{item.extraCount}}" class="note">另有{{item.extraCount}}款商品，点订单详情查看</view>
    <view class="row line"><text class="muted">共{{item.quantity}}件</text><text class="price">¥{{item.totalText}}</text></view>
    <view wx:if="{{item.contactName}}" class="note">{{item.deliveryMode==='pickup'?'取货人':'收货人'}}：{{item.contactName}}　{{item.contactPhone}}</view>
    <view wx:if="{{item.wechatShippingSynced}}" class="note">微信发货信息已同步</view><view wx:if="{{item.wechatShippingError}}" class="error">{{item.wechatShippingError}}<button class="secondary" data-id="{{item.id}}" bindtap="syncShipping" disabled="{{busy}}" hover-start-time="30" hover-stay-time="80">重试同步</button></view><view class="order-id muted space-top" selectable="true">{{item.id}}</view><view class="order-time">{{item.dateText}}</view>
    <view class="note" wx:if="{{item.refundReason}}">此前售后记录：{{item.refundReason}}</view>
    <view wx:if="{{fulfillmentId===item.id}}" class="fulfillment-editor fulfillment-panel">
      <view class="section">{{item.deliveryMode==='pickup'?'核销这笔自取订单':'填写这笔订单的发货信息'}}</view>
      <block wx:if="{{item.deliveryMode!=='pickup'}}"><picker wx:if="{{!demo}}" range="{{carriers}}" range-key="name" value="{{carrierIndex}}" bindchange="carrierChange" disabled="{{busy}}"><view class="field">{{carrier || '请选择快递公司'}}</view></picker><input wx:else class="field" placeholder="快递公司" value="{{carrier}}" data-field="carrier" bindinput="field" disabled="{{busy}}"/><input class="field" placeholder="这笔订单的快递单号" value="{{tracking}}" data-field="tracking" bindinput="field" disabled="{{busy}}" maxlength="64"/></block>
      <block wx:else><input class="field" value="{{pickupCode}}" placeholder="顾客出示的6位自取码" maxlength="6" type="number" data-field="pickupCode" bindinput="field" disabled="{{busy}}"/><view class="note">核对本订单顾客及商品，交付时确认核销。</view></block>
      <view class="row space-top"><button class="secondary" bindtap="closeFulfillment" disabled="{{busy}}">取消</button><button wx:if="{{item.deliveryMode!=='pickup'}}" class="primary" data-id="{{item.id}}" bindtap="ship" disabled="{{busy}}" loading="{{busy}}">{{demo?'模拟发货':'确认发货'}}</button><button wx:else class="primary" data-id="{{item.id}}" data-action="completePickup" bindtap="pickup" disabled="{{busy}}" loading="{{busy}}">确认核销</button></view>
    </view>
    <view class="row space-top"><button class="secondary" data-id="{{item.id}}" bindtap="open" hover-start-time="30" hover-stay-time="80">订单详情</button><button wx:if="{{item.kind!=='payment_test' && item.status==='paid' && item.deliveryMode!=='pickup' && fulfillmentId!==item.id}}" class="primary" data-id="{{item.id}}" bindtap="beginFulfillment" disabled="{{busy}}" hover-start-time="30" hover-stay-time="80">填写发货信息</button><button wx:if="{{item.kind!=='payment_test' && item.status==='paid' && item.deliveryMode==='pickup'}}" class="primary" data-id="{{item.id}}" data-action="preparePickup" bindtap="pickup" disabled="{{busy}}" hover-start-time="30" hover-stay-time="80">备货完成</button><button wx:if="{{item.kind!=='payment_test' && item.status==='ready_pickup' && fulfillmentId!==item.id}}" class="primary" data-id="{{item.id}}" bindtap="beginFulfillment" disabled="{{busy}}" hover-start-time="30" hover-stay-time="80">核对自取码</button></view>
  </view>
  <button wx:if="{{hasMore}}" class="secondary" bindtap="more" loading="{{loading}}" disabled="{{loading}}" hover-start-time="30" hover-stay-time="80">查看更多订单</button>
</view>
