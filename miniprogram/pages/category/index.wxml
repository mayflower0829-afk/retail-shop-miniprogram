<import src="../../templates/loading.wxml"/>
<view class="category-page page-motion"><view class="category-header"><view class="title">找到你的心头好</view><view class="search-box"><input class="search" placeholder="作品、角色、款式，可空格组合搜索" value="{{keyword}}" bindinput="search" bindconfirm="confirmSearch" confirm-type="search" maxlength="80"/><button wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch" aria-label="清空搜索">×</button></view><view class="chips group-chips"><view wx:for="{{groups}}" wx:key="*this" class="chip {{group===item?'active':''}}" data-value="{{item}}" bindtap="group" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">{{item==='全部'?'全部商品':item+'专区'}}</view></view></view>
 <view class="catalog-layout"><scroll-view scroll-y class="ip-sidebar"><view class="sidebar-label">作品 / IP</view><view wx:for="{{ips}}" wx:key="*this" class="ip-option {{ip===item?'active':''}}" data-value="{{item}}" bindtap="ip" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">{{item}}</view></scroll-view>
 <scroll-view scroll-y class="catalog-content" scroll-top="{{catalogScrollTop}}" bindscroll="scrolled"><scroll-view scroll-x class="type-scroll"><view class="chips type-chips"><view wx:for="{{types}}" wx:key="*this" class="chip {{type===item?'active':''}}" data-value="{{item}}" bindtap="type" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback">{{item}}</view></view></scroll-view><view class="row result-bar"><text class="muted">{{ip==='全部'?'全部作品':ip}}</text><text class="muted">{{resultCount || 0}} 件</text><text wx:if="{{filtersActive}}" class="link small" bindtap="resetFilters">重置</text></view>
 <template wx:if="{{loading && !visible.length}}" is="product-list-loading"/><view wx:if="{{visible.length}}" class="content-motion"><view class="category-product" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="detail" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><image src="{{item.image}}" mode="aspectFit" lazy-load data-id="{{item.id}}" catchtap="preview" aria-role="button" aria-label="预览{{item.displayName}}图片"/><view class="grow"><view class="two-lines">{{item.displayName}}</view><text class="tag">{{item.type}}</text><view class="row"><view><text class="price">¥{{item.priceText}}</text><text wx:if="{{item.hasDiscount}}" class="original-price">¥{{item.originalPriceText}}</text></view><button class="quick-add" data-id="{{item.id}}" catchtap="quickAdd" disabled="{{item.stock===0}}" hover-start-time="30" hover-stay-time="80">{{item.stock===0?'售罄':item.skus.length>1?'选款':'+ 加购'}}</button></view></view></view></view><button wx:if="{{hasMore}}" class="secondary more-button" bindtap="more" hover-start-time="30" hover-stay-time="80">查看更多商品</button><view wx:if="{{!visible.length && !loading}}" class="empty">{{error || '没有符合筛选的商品'}}<button wx:if="{{error}}" class="secondary" bindtap="reload" hover-start-time="30" hover-stay-time="80">重新加载</button><button wx:elif="{{filtersActive}}" class="secondary" bindtap="resetFilters">查看全部商品</button></view></scroll-view></view>
</view>
