<view class="category-page"><view class="category-header"><view class="title">找到你的心头好</view><input class="search" placeholder="搜索作品或商品名称" value="{{keyword}}" bindinput="search"/><view class="chips group-chips"><view wx:for="{{groups}}" wx:key="*this" class="chip {{group===item?'active':''}}" data-value="{{item}}" bindtap="group">{{item==='全部'?'全部商品':item+'专区'}}</view></view></view>
 <view class="catalog-layout"><scroll-view scroll-y class="ip-sidebar"><view class="sidebar-label">作品 / IP</view><view wx:for="{{ips}}" wx:key="*this" class="ip-option {{ip===item?'active':''}}" data-value="{{item}}" bindtap="ip">{{item}}</view></scroll-view>
 <scroll-view scroll-y class="catalog-content"><scroll-view scroll-x class="type-scroll"><view class="chips type-chips"><view wx:for="{{types}}" wx:key="*this" class="chip {{type===item?'active':''}}" data-value="{{item}}" bindtap="type">{{item}}</view></view></scroll-view><view class="row result-bar"><text class="muted">{{ip==='全部'?'全部作品':ip}}</text><text class="muted">{{resultCount || 0}} 件</text></view>
 <view class="category-product" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.image}}" mode="aspectFit" lazy-load data-id="{{item.id}}" catchtap="preview" aria-role="button" aria-label="预览{{item.displayName}}图片"/><view class="grow"><view class="two-lines">{{item.displayName}}</view><text class="tag">{{item.type}}</text><view class="row"><view><text class="price">¥{{item.priceText}}</text><text wx:if="{{item.hasDiscount}}" class="original-price">¥{{item.originalPriceText}}</text></view><button class="quick-add" data-id="{{item.id}}" catchtap="quickAdd" disabled="{{item.stock===0}}">{{item.stock===0?'售罄':item.skus.length>1?'选款':'+ 加购'}}</button></view></view></view><button wx:if="{{hasMore}}" class="secondary more-button" bindtap="more">查看更多商品</button><view wx:if="{{!visible.length && !loading}}" class="empty">{{error || '没有符合筛选的商品'}}<button wx:if="{{error}}" class="secondary" bindtap="reload">重新加载</button></view><view wx:if="{{loading}}" class="empty">正在加载商品…</view></scroll-view></view>
</view>
