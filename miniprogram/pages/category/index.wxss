/* 共用样式位于 app.wxss */

.ip-sidebar{background:#f4f3f5}.ip-option{margin:4rpx 0;padding:24rpx 14rpx;border-radius:0 18rpx 18rpx 0}.ip-option.active{background:#fff}.sidebar-label{letter-spacing:2rpx}.category-product:last-child{border-bottom:0}.category-product .tag{font-size:19rpx;margin:8rpx 0 14rpx;padding:3rpx 10rpx}.category-product .quick-add{width:auto;min-height:56rpx;height:56rpx;line-height:56rpx}.category-product .two-lines{font-weight:550}.catalog-content .result-bar{padding-bottom:8rpx;border-bottom:1rpx solid #f4ecee}

.category-product .grow>.row{flex-wrap:wrap;gap:10rpx}.category-product .quick-add{width:auto;flex-shrink:0;margin-left:auto;min-width:0}.catalog-content .result-bar{flex-wrap:wrap;gap:8rpx}.catalog-content .result-bar>text:first-child{flex:1;min-width:0;word-break:break-word}.catalog-content .result-bar>text:not(:first-child){flex-shrink:0}
