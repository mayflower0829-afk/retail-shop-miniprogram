<import src="../../templates/loading.wxml"/>
<view class="page orders-page page-motion"><view class="title">我的订单</view><scroll-view scroll-x class="filter-scroll" scroll-into-view="status-{{status}}"><view class="tabs"><text wx:for="{{tabs}}" wx:key="id" id="status-{{item.id}}" class="tab {{status===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</text></view></scroll-view>
 <view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="reload" hover-start-time="30" hover-stay-time="80">重新加载</button></view>
 <view wx:for="{{visible}}" wx:key="id" class="card order-card" data-id="{{item.id}}" bindtap="open" hover-start-time="30" hover-stay-time="80" hover-class="tap-feedback"><view class="row order-heading"><text class="muted">{{item.dateText}} · {{item.kind==='payment_test'?'1分钱支付测试':item.demo?'演示订单':item.deliveryMode==='pickup'?'自取订单':'示例零售店'}}</text><text class="order-status">{{item.statusName}}</text></view><view class="order-product row" wx:for="{{item.preview}}" wx:for-item="line" wx:key="skuId"><image class="thumb" src="{{line.image}}" mode="aspectFit" lazy-load/><view class="grow"><view class="two-lines">{{line.displayName || line.name}}</view><view class="muted space-top">{{line.skuName==='表中原款'?'':line.skuName}} × {{line.qty}}</view></view></view><view wx:if="{{item.kind==='payment_test'}}" class="note">微信支付流程测试 · 不发货</view><view wx:if="{{item.extraCount}}" class="muted">另有 {{item.extraCount}} 种商品</view><view class="row order-footer"><text class="muted">查看详情 ›</text><view>合计 <text class="price">¥{{item.totalText}}</text></view></view></view>
 <view wx:if="{{!visible.length && !loading && !error}}" class="empty"><view class="empty-icon">♡</view><view>这里还没有订单</view><view class="muted">选购喜欢的商品</view><button class="secondary space-top" bindtap="browse" hover-start-time="30" hover-stay-time="80">去选款</button></view><button wx:if="{{hasMore}}" class="secondary" loading="{{loading}}" disabled="{{loading}}" bindtap="more" hover-start-time="30" hover-stay-time="80">查看更多订单</button><template wx:if="{{loading && !visible.length}}" is="orders-loading"/>
</view>
