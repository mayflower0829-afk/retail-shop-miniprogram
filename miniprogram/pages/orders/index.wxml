<view class="page orders-page"><view class="title">每一份喜欢，都有记录</view><view class="subtitle">我的订单</view><scroll-view scroll-x class="filter-scroll"><view class="tabs"><text wx:for="{{tabs}}" wx:key="id" class="tab {{status===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</text></view></scroll-view>
 <view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="reload">重新加载</button></view>
 <view wx:for="{{visible}}" wx:key="id" class="card order-card" data-id="{{item.id}}" bindtap="open"><view class="row order-heading"><text class="muted">{{item.dateText}} · {{item.demo?'演示订单':item.deliveryMode==='pickup'?'自取订单':'示例零售店'}}</text><text class="order-status">{{item.statusName}}</text></view><view class="order-product row" wx:for="{{item.preview}}" wx:for-item="line" wx:key="skuId"><image class="thumb" src="{{line.image}}" mode="aspectFit"/><view class="grow"><view class="two-lines">{{line.displayName || line.name}}</view><view class="muted space-top">{{line.skuName==='表中原款'?'':line.skuName}} × {{line.qty}}</view></view></view><view wx:if="{{item.extraCount}}" class="muted">另有 {{item.extraCount}} 种商品</view><view class="row order-footer"><text class="muted">查看详情 ›</text><view>合计 <text class="price">¥{{item.totalText}}</text></view></view></view>
 <view wx:if="{{!visible.length && !loading && !error}}" class="empty"><view class="empty-icon">♡</view><view>这里还没有订单</view><view class="muted">把心仪的谷子带回家吧</view><button class="secondary space-top" bindtap="browse">去选款</button></view><button wx:if="{{hasMore}}" class="secondary" loading="{{loading}}" disabled="{{loading}}" bindtap="more">查看更多订单</button><view wx:if="{{loading && !visible.length}}" class="empty">正在加载订单…</view>
</view>
