<view class="frame"><view wx:if="{{state==='empty'}}" class="hint">暂无图片</view><image wx:for="{{frames}}" wx:key="key" class="photo {{state==='loaded'?'ready':''}}" src="{{item.src}}" mode="{{mode}}" lazy-load data-key="{{item.key}}" bindload="loaded" binderror="failed"/><view wx:if="{{state==='failed'}}" class="retry hint" catchtap="retry" aria-role="button" aria-label="重新加载商品图片"><text>图片未加载</text><text class="retry-label">点击重试</text></view></view>
